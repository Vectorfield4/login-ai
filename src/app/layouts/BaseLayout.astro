---
import type { ImageMetadata } from "astro";
import "../styles/global.css";
import { routeUrl } from "../../shared/data/routes";
import { resolvePageMeta, resolveSchemaOrg } from "../../shared/data/seo";
import { darkThemeClassName } from "../../shared/design/theme";

interface Props {
  /** Код языка страницы: "ru" или "en". */
  lang: "ru" | "en";
  title: string;
  description: string;
  /** Чистый путь текущей страницы (без языкового префикса) — для hreflang/canonical. */
  path?: string;
  /** Тематическая иллюстрация в виде Astro ImageMetadata. */
  image?: ImageMetadata | { src: string };
}

const { lang, title, description, path = "/", image } = Astro.props;

const base = Astro.site ?? new URL("https://loginai.ru");
const canonical = new URL(routeUrl(path, lang), base);
const ruUrl = new URL(routeUrl(path, "ru"), base);
const enUrl = new URL(routeUrl(path, "en"), base);
const defaultUrl = ruUrl;
const meta = resolvePageMeta(lang, path);
const imageSrc = image?.src ?? meta.ogImage;
const imageUrl = new URL(imageSrc, base).href;
const schemas = resolveSchemaOrg(lang, path, canonical.href, base.href, imageSrc);
const ogLocale = lang === "ru" ? "ru_RU" : "en_US";
const ogType = path === "/" ? "website" : "article";
---

<!doctype html>
<html lang={lang} data-theme-class={darkThemeClassName}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={ruUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Login AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:image" content={imageUrl} />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const theme: "light" | "dark" =
          stored === "light" || stored === "dark"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        const root = document.documentElement;
        root.setAttribute("data-theme", theme);
        // Классы StyleX-темы: переопределяют hashed-переменные компонентов.
        const themeClasses = (root.getAttribute("data-theme-class") || "").split(/\s+/);
        for (const cls of themeClasses) {
          root.classList.toggle(cls, theme === "dark");
        }
      })();
    </script>
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
  </head>
  <body>
    <slot />
  </body>
</html>