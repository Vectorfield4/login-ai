---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import "../styles/global.css";
import { routeUrl } from "../../shared/data/routes";
import {
  resolvePageMeta,
  resolveSchemaOrg,
  type SeoTextOverrides,
} from "../../shared/data/seo";
import { darkThemeClassName } from "../../shared/design/theme";

interface Props {
  lang: "ru" | "en";
  /** Document title. Falls back to `resolvePageMeta` when omitted. */
  title?: string;
  /** Meta description. Falls back to `resolvePageMeta` when omitted. */
  description?: string;
  path?: string;
  image?: ImageMetadata;
  /** Head text the page knows better than the route catalog (news articles). */
  seo?: SeoTextOverrides;
  /**
   * Clean paths of the translations that actually exist. Defaults to `path`
   * for both locales. News articles pass only the published ones, so an
   * asymmetric article never advertises a 404 to crawlers.
   */
  alternates?: { ru?: string; en?: string };
  /** Label of the leaf breadcrumb for routes outside the fixture catalog. */
  entityTitle?: string;
  /** Extra JSON-LD blocks appended after Organization/WebSite. */
  extraSchemas?: object[];
  /** `article:published_time` and friends; only for article pages. */
  articleMeta?: { publishedTime?: string; modifiedTime?: string };
}

const {
  lang,
  title,
  description,
  path = "/",
  image,
  seo,
  alternates,
  entityTitle,
  extraSchemas,
  articleMeta,
} = Astro.props;

const base = Astro.site ?? new URL("https://loginai.ru");
const canonical = Astro.url;
const ensureTrailingSlash = (urlStr: string) => (urlStr.endsWith("/") ? urlStr : `${urlStr}/`);

// The own language always has a page; the other one only if it is published.
// Without `alternates` both languages are assumed to exist, as before.
const ruPath = alternates ? (lang === "ru" ? path : alternates.ru) : path;
const enPath = alternates ? (lang === "en" ? path : alternates.en) : path;
const ruUrl = ruPath ? new URL(ensureTrailingSlash(routeUrl(ruPath, "ru")), base) : undefined;
const enUrl = enPath ? new URL(ensureTrailingSlash(routeUrl(enPath, "en")), base) : undefined;
// x-default points at the translation we can guarantee: Russian if present,
// otherwise the only language that exists.
const defaultUrl = ruUrl ?? enUrl;

const overrides: SeoTextOverrides = {
  ...seo,
  title: title ?? seo?.title,
  description: description ?? seo?.description,
};
const meta = resolvePageMeta(lang, path, image, overrides);

let imageUrl: string | undefined = undefined;
const ogSource = meta.ogImage;
if (ogSource) {
  const optimizedOgImage = await getImage({
    src: ogSource,
    format: "png",
    width: 1200,
    height: 630,
  });
  imageUrl = new URL(optimizedOgImage.src, base).href;
}

const finalDescription = meta.description.length > 155 
  ? `${meta.description.slice(0, 152)}...` 
  : meta.description;

const finalOgDescription = meta.ogDescription.length > 125 
  ? `${meta.ogDescription.slice(0, 122)}...` 
  : meta.ogDescription;

const schemas = resolveSchemaOrg(lang, path, canonical.href, base.href, ogSource, {
  entityTitle,
  extraSchemas,
});
const ogLocale = lang === "ru" ? "ru_RU" : "en_US";
const ogType = path === "/" ? "website" : "article";
---

<!doctype html>
<html lang={lang} data-theme-class={darkThemeClassName}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{meta.title}</title>
    <meta name="description" content={finalDescription} />
    <link rel="canonical" href={canonical.href} />
    {ruUrl && <link rel="alternate" hreflang="ru" href={ruUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {defaultUrl && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={finalOgDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Login AI" />
    {articleMeta?.publishedTime && (
      <meta property="article:published_time" content={articleMeta.publishedTime} />
    )}
    {articleMeta?.modifiedTime && (
      <meta property="article:modified_time" content={articleMeta.modifiedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={finalOgDescription} />
    
    {imageUrl && (
      <meta property="og:image" content={imageUrl} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:type" content="image/png" />
      <meta name="twitter:image" content={imageUrl} />
    )}

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const theme =
          stored === "light" || stored === "dark"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        const root = document.documentElement;
        root.setAttribute("data-theme", theme);
        const themeClasses = (root.getAttribute("data-theme-class") || "").split(/\s+/);
        for (const cls of themeClasses) {
          root.classList.toggle(cls, theme === "dark");
        }
      })();
    </script>
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
  </head>
  <body>
    <slot />
  </body>
</html>
