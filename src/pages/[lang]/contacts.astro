---
import BaseLayout from "../../app/layouts/BaseLayout.astro";
import { CONTACT_EMAIL } from "../../shared/config/constants";
import { resolvePageMeta } from "../../shared/data/seo";
import { astroDicts } from "../../shared/i18n/dict";
import { createT } from "../../shared/i18n/t";
import { Card, CardContent, Container, Grid, IconCircle, Section, Stack, Typography } from "../../shared/ui/atoms";
import { SectionHeader } from "../../shared/ui/molecules";
import { PageHero } from "../../shared/ui/organisms/PageHero";
import { AppBar } from "../../widgets/app-bar";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const currentLang = lang as "ru" | "en";
const meta = resolvePageMeta(currentLang, "/contacts");
const t = createT(currentLang, astroDicts);
---

<BaseLayout lang={currentLang} title={meta.title} description={meta.description} path="/contacts">
  <div class="page">
    <AppBar lang={currentLang} client:visible />
    <main class="page-main">
      <PageHero
        title={t("contactsPage.title")}
        subtitle={t("contactsPage.subtitle")}
        text={t("contactsPage.text")}
      />

      <Section alt>
        <Container>
          <SectionHeader
            eyebrow={t("contactsPage.sectionEyebrow")}
            title={t("contactsPage.sectionTitle")}
            subtitle={t("contactsPage.sectionSubtitle")}
          />
          <Grid container spacing={3}>
            <Grid item size={12} md={6}>
              <Card variant="accent">
                <CardContent>
                  <Stack gap={2}>
                    <IconCircle>✉</IconCircle>
                    <Typography variant="h6">{t("contactsPage.emailCardTitle")}</Typography>
                    <Typography variant="body2" color="textSecondary">
                      {t("contactsPage.emailCardText")}
                    </Typography>
                    <a href={`mailto:${CONTACT_EMAIL}`} style="font-weight: 600; color: inherit;">
                      {CONTACT_EMAIL}
                    </a>
                  </Stack>
                </CardContent>
              </Card>
            </Grid>
            <Grid item size={12} sm={6} md={3}>
              <Card>
                <CardContent>
                  <Stack gap={2}>
                    <IconCircle color="secondary">⏱</IconCircle>
                    <Typography variant="h6">{t("contactsPage.fastCardTitle")}</Typography>
                    <Typography variant="body2" color="textSecondary">
                      {t("contactsPage.fastCardText")}
                    </Typography>
                  </Stack>
                </CardContent>
              </Card>
            </Grid>
            <Grid item size={12} sm={6} md={3}>
              <Card>
                <CardContent>
                  <Stack gap={2}>
                    <IconCircle color="success">☂</IconCircle>
                    <Typography variant="h6">{t("contactsPage.personalCardTitle")}</Typography>
                    <Typography variant="body2" color="textSecondary">
                      {t("contactsPage.personalCardText")}
                    </Typography>
                  </Stack>
                </CardContent>
              </Card>
            </Grid>
          </Grid>
        </Container>
      </Section>
    </main>
  </div>
</BaseLayout>