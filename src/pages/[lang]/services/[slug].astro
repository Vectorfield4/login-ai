---
import { Image } from "astro:assets";
import { getNewsReferencing } from "../../../app/data/newsCollection";
import { getServiceDiagram } from "../../../app/data/serviceDiagrams";
import { getServiceImage } from "../../../app/data/serviceImages";
import BaseLayout from "../../../app/layouts/BaseLayout.astro";
import { getServiceBySlug, getServices, TechStackSection } from "../../../entities/service";
import { resolveBreadcrumbs } from "../../../shared/data/breadcrumbs";
import { resolveEntityIcon } from "../../../shared/data/iconCatalog";
import { routeUrl } from "../../../shared/data/routes";
import { SCHEMA_TYPE, schemaIri } from "../../../shared/data/schema";
import { resolvePageMeta } from "../../../shared/data/seo";
import { astroDicts } from "../../../shared/i18n/dict";
import { createT } from "../../../shared/i18n/t";
import {
  Button,
  Container,
  Grid,
  IconCircle,
  Section,
  Stack,
  Typography,
} from "../../../shared/ui/atoms";
import { BlockSection } from "../../../shared/ui/organisms/BlockSection";
import { Breadcrumbs } from "../../../shared/ui/organisms/Breadcrumbs";
import { CtaBlock } from "../../../shared/ui/organisms/CtaBlock";
import { DeliverablesSection } from "../../../shared/ui/organisms/DeliverablesSection";
import { FaqSection } from "../../../shared/ui/organisms/FaqSection";
import { FeatureCard } from "../../../shared/ui/organisms/FeatureCard";
import { FitSection } from "../../../shared/ui/organisms/FitSection";
import { MechanismSection } from "../../../shared/ui/organisms/MechanismSection";
import { OutcomesSection } from "../../../shared/ui/organisms/OutcomesSection";
import { ProcessHorizontal } from "../../../shared/ui/organisms/ProcessHorizontal";
import { ProofSection } from "../../../shared/ui/organisms/ProofSection";
import { ScopeSection } from "../../../shared/ui/organisms/ScopeSection";
import { SectionsBlock } from "../../../shared/ui/organisms/SectionsBlock";
import { TradeoffsSection } from "../../../shared/ui/organisms/TradeoffsSection";
import { AppBar } from "../../../widgets/app-bar";
import { ServiceEcosystemSection } from "../../../widgets/service-ecosystem";

export function getStaticPaths() {
  const langs = ["ru", "en"] as const;
  const services = getServices();
  return langs.flatMap((lang) =>
    services.map((service) => ({
      params: { lang, slug: service.slug },
    }))
  );
}

const { lang, slug } = Astro.params;
const currentLang = lang as "ru" | "en";
const service = getServiceBySlug(slug);
if (!service) {
  return Astro.redirect(`/${lang}/404`);
}

const meta = resolvePageMeta(currentLang, `/services/${slug}`);
const t = createT(currentLang, astroDicts);
const cover = getServiceImage(slug);
const Icon = resolveEntityIcon(service.icon);
const breadcrumbs = resolveBreadcrumbs(`/services/${slug}`, currentLang);
// Обратная связь: статьи, ссылающиеся на эту услугу в frontmatter. Список
// уже отсортирован и отфильтрован по локали, поэтому EN-страница не
// соберёт ссылку на несуществующий английский перевод.
const relatedNews = await getNewsReferencing("service", slug, currentLang);
// Механизм: слаг диаграммы резолвится в светлый и тёмный SVG здесь, на слое,
// который знает ImageMetadata. Entity хранит только слаг.
const mechanismItems = service.mechanism?.map((item) => {
  const diagram = item.diagram
    ? getServiceDiagram(service.slug, item.diagram, currentLang)
    : undefined;
  return {
    ...item,
    image: diagram ? { light: diagram.light.src, dark: diagram.dark.src } : undefined,
  };
});
---

<BaseLayout
  lang={currentLang}
  title={meta.title}
  description={meta.description}
  path={`/services/${slug}`}
  image={cover}
  schemaOptions={{ faqItems: service.faqItems, processSteps: service.processSteps }}
>
  <div class="page">
    <AppBar lang={currentLang} client:visible />
    <main class="page-main" itemScope itemType={schemaIri(SCHEMA_TYPE.webPage)}>
      {breadcrumbs ? (
        <Breadcrumbs items={breadcrumbs.items} lang={currentLang} />
      ) : null}

      <Section itemScope itemProp="mainEntity" itemType={schemaIri(SCHEMA_TYPE.service)}>
        <Container>
          <Stack gap={2}>
            {cover ? (
              <div style="position: relative; border-radius: 12px; overflow: hidden;">
                <Image
                  src={cover}
                  alt={t(service.title)}
                  width={1200}
                  height={630}
                  loading="eager"
                  style="width: 100%; height: auto; display: block;"
                />
                <div
                  style="position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.78) 100%);"
                  aria-hidden="true"
                >
                </div>
                <div
                  style="position: absolute; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; gap: 8px; padding: 24px; color: #fff;"
                >
                  <Stack direction="row" gap={2} alignItems="center">
                    <IconCircle size={56}>
                      <Icon size={26} />
                    </IconCircle>
                    <Typography variant="h2" component="h1" itemProp="name">
                      {t(service.title)}
                    </Typography>
                  </Stack>
                  <Typography variant="body1" itemProp="description">
                    {t(service.description)}
                  </Typography>
                </div>
              </div>
            ) : (
              <>
                <Stack direction="row" gap={2} alignItems="center">
                  <IconCircle size={64}>
                    <Icon size={28} />
                  </IconCircle>
                  <Typography variant="h2" component="h1" itemProp="name">
                    {t(service.title)}
                  </Typography>
                </Stack>
                <Typography variant="body1" itemProp="description">
                  {t(service.description)}
                </Typography>
              </>
            )}
            <Typography variant="h6" color="textSecondary">
              {t(service.tagline)}
            </Typography>
            <Stack direction="row" gap={1}>
              <Button href={routeUrl("/contacts", currentLang)} variant="contained" size="large">
                {t("servicePage.ctaButton")}
              </Button>
            </Stack>
          </Stack>
        </Container>
      </Section>

      <BlockSection
        alt
        eyebrow={t("servicePage.featuresEyebrow")}
        title={t("servicePage.featuresTitle")}
      >
        <Grid container spacing={3}>
          {service.features.map((feature) => (
            <Grid key={feature.title} item size={12} md={6}>
              <FeatureCard lang={currentLang} title={feature.title} text={feature.text} />
            </Grid>
          ))}
        </Grid>
      </BlockSection>

      {service.processSteps?.length ? (
        <ProcessHorizontal client:load lang={currentLang} eyebrow="servicePage.processEyebrow" title="servicePage.processTitle" items={service.processSteps} />
      ) : null}

      {service.fitItems?.length ? (
        <FitSection lang={currentLang} alt eyebrow="servicePage.fitEyebrow" title="servicePage.fitTitle" items={service.fitItems} />
      ) : null}

      {service.proofItems?.length ? (
        <ProofSection lang={currentLang} eyebrow="servicePage.proofEyebrow" title="servicePage.proofTitle" items={service.proofItems} />
      ) : null}

      {service.deliverables?.length ? (
        <DeliverablesSection
          alt
          lang={currentLang}
          eyebrow="servicePage.deliverablesEyebrow"
          title="servicePage.deliverablesTitle"
          items={service.deliverables}
        />
      ) : null}

      {service.scope?.length ? (
        <ScopeSection
          lang={currentLang}
          eyebrow="servicePage.scopeEyebrow"
          title="servicePage.scopeTitle"
          items={service.scope}
        />
      ) : null}

      {mechanismItems?.length ? (
        <MechanismSection
          lang={currentLang}
          eyebrow="servicePage.mechanismEyebrow"
          title="servicePage.mechanismTitle"
          items={mechanismItems}
        />
      ) : null}

      {service.outcomes?.length ? (
        <OutcomesSection
          alt
          lang={currentLang}
          eyebrow="servicePage.outcomesEyebrow"
          title="servicePage.outcomesTitle"
          items={service.outcomes}
        />
      ) : null}

      {service.tradeoffs?.length ? (
        <TradeoffsSection
          alt
          lang={currentLang}
          eyebrow="servicePage.tradeoffsEyebrow"
          title="servicePage.tradeoffsTitle"
          items={service.tradeoffs}
        />
      ) : null}

      {service.sections?.map((section, index) => (
        <BlockSection key={section.title} alt={index % 2 === 1} title={t(section.title)}>
          <SectionsBlock lang={currentLang} sections={[section]} />
        </BlockSection>
      ))}

      {service.techStack?.length ? (
        <TechStackSection groups={service.techStack} lang={currentLang} client:visible />
      ) : null}

      <ServiceEcosystemSection relevants={service.relevants} lang={currentLang} />

      {service.faqItems?.length ? (
        <FaqSection lang={currentLang} alt eyebrow="servicePage.faqEyebrow" title="servicePage.faqTitle" items={service.faqItems} />
      ) : null}

      <CtaBlock
        title={t("servicePage.ctaTitle")}
        text={t("servicePage.ctaText")}
        buttonLabel={t("servicePage.ctaButton")}
        to="/contacts"
        lang={currentLang}
      />
    </main>
  </div>
</BaseLayout>