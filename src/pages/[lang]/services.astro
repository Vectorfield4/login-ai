---
import BaseLayout from "../../app/layouts/BaseLayout.astro";
import { getServices, ServiceCard } from "../../entities/service";
import { resolveBreadcrumbs } from "../../shared/data/breadcrumbs";
import { SCHEMA_TYPE, schemaIri } from "../../shared/data/schema";
import { resolvePageMeta } from "../../shared/data/seo";
import { astroDicts } from "../../shared/i18n/dict";
import { createT } from "../../shared/i18n/t";
import { Container, Grid, Section } from "../../shared/ui/atoms";
import { SectionHeader } from "../../shared/ui/molecules";
import { Breadcrumbs } from "../../shared/ui/organisms/Breadcrumbs";
import { CtaBlock } from "../../shared/ui/organisms/CtaBlock";
import { PageHero } from "../../shared/ui/organisms/PageHero";
import { AppBar } from "../../widgets/app-bar";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const currentLang = lang as "ru" | "en";
const meta = resolvePageMeta(currentLang, "/services");
const t = createT(currentLang, astroDicts);
const services = getServices();
const breadcrumbs = resolveBreadcrumbs("/services", currentLang);
---

<BaseLayout lang={currentLang} title={meta.title} description={meta.description} path="/services">
  <div class="page">
    <AppBar lang={currentLang} client:visible />
    <main class="page-main" itemScope itemType={schemaIri(SCHEMA_TYPE.collectionPage)}>
      {breadcrumbs ? (
        <Breadcrumbs items={breadcrumbs.items} lang={currentLang} />
      ) : null}

      <PageHero
        title={t("servicesPage.title")}
        subtitle={t("servicesPage.subtitle")}
        text={t("servicesPage.text")}
      />

      <Section alt>
        <Container>
          <SectionHeader
            eyebrow={t("servicesPage.sectionEyebrow")}
            title={t("servicesPage.sectionTitle")}
            subtitle={t("servicesPage.sectionSubtitle")}
          />
          <Grid container spacing={3} itemScope itemType={schemaIri(SCHEMA_TYPE.itemList)}>
            {services.map((service, index) => (
              <Grid item key={service.slug} size={12} md={6} lg={4}>
                <ServiceCard service={service} lang={currentLang} position={index + 1} />
              </Grid>
            ))}
          </Grid>
        </Container>
      </Section>

      <CtaBlock
        title={t("servicesPage.ctaTitle")}
        text={t("servicesPage.ctaText")}
        buttonLabel={t("servicesPage.ctaButton")}
        to="/contacts"
        lang={currentLang}
      />
    </main>
  </div>
</BaseLayout>