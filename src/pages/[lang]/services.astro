---
import { getRelativeLocaleUrl } from "astro:i18n";
import AppBar from "../../components/AppBar";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SERVICE_ICONS } from "../../shared/data/serviceCatalog";
import { astroDicts } from "../../shared/i18n/dict";
import { createT } from "../../shared/i18n/t";
import { Card, CardContent, Container, Grid, Typography } from "../../shared/ui/atoms";
import { ServiceCard } from "../../shared/ui/organisms/ServiceCard";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = createT(lang as "ru" | "en", astroDicts);

const slugs = Object.keys(SERVICE_ICONS);

const meta = {
  ru: { title: t("servicesPage.title"), description: t("servicesPage.metaDescription") },
  en: { title: t("servicesPage.title"), description: t("servicesPage.metaDescription") },
};
---

<BaseLayout lang={lang as "ru" | "en"} title={meta[lang as "ru" | "en"].title} description={meta[lang as "ru" | "en"].description}>
  <div class="page">
    <AppBar lang={lang as "ru" | "en"} client:visible />
    <main class="page-main">
      <Container>
        <section class="section">
          <Typography variant="h1">{t("servicesPage.title")}</Typography>
          <Typography variant="body1" color="textSecondary">
            {t("servicesPage.subtitle")}
          </Typography>
        </section>

        <section class="section">
          <Typography variant="h2">{t("servicesPage.sectionTitle")}</Typography>
          <Typography variant="body1" color="textSecondary">
            {t("servicesPage.sectionSubtitle")}
          </Typography>
        </section>
      </Container>

      <Container>
        <Grid container spacing={2}>
          {
            slugs.map((slug) => {
              const icon = SERVICE_ICONS[slug];
              return (
                <Grid item size={12} md={6} lg={4}>
                  <ServiceCard
                    icon={icon}
                    title={t(`services.${slug}.title`)}
                    tagline={t(`services.${slug}.tagline`)}
                    href={getRelativeLocaleUrl(lang as "ru" | "en", `/services/${slug}`)}
                  />
                </Grid>
              );
            })
          }
        </Grid>
      </Container>

      <Container>
        <Card>
          <CardContent>
            <Typography variant="h6">{t("servicesPage.ctaTitle")}</Typography>
            <Typography variant="body2" color="textSecondary">
              {t("servicesPage.ctaText")}
            </Typography>
          </CardContent>
        </Card>
      </Container>
    </main>
  </div>
</BaseLayout>