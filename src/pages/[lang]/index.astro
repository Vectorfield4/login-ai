---
import { getNewsForLang } from "../../app/data/newsCollection";
import { getServiceImage } from "../../app/data/serviceImages";
import { getSolutionImage } from "../../app/data/solutionImages";
import BaseLayout from "../../app/layouts/BaseLayout.astro";
import { getServices } from "../../entities/service";
import { getSolutions } from "../../entities/solution";
import { HomeNews, toHomeNewsItem } from "../../features/home-news";
import { HomeSolutions, toHomeSolution } from "../../features/home-solutions";
import { routeUrl } from "../../shared/data/routes";
import { resolvePageMeta } from "../../shared/data/seo";
import { astroDicts } from "../../shared/i18n/dict";
import { createT } from "../../shared/i18n/t";
import { Button, Container, Section, Typography } from "../../shared/ui/atoms";
import { SectionHeader } from "../../shared/ui/molecules";
import { CtaBlock } from "../../shared/ui/organisms/CtaBlock";
import { AppBar } from "../../widgets/app-bar";
import { ServiceTabsSection } from "../../widgets/service-ecosystem";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const currentLang = lang as "ru" | "en";
const t = createT(currentLang, astroDicts);
const services = getServices();
const serviceCovers = Object.fromEntries(
  services.flatMap((service) => {
    const image = getServiceImage(service.slug);
    return image ? [[service.slug, { src: image.src }]] : [];
  }),
);
const solutions = getSolutions().map((s) => toHomeSolution(s, getSolutionImage(s.slug)?.src));
const news = (await getNewsForLang(currentLang)).slice(0, 3).map(toHomeNewsItem);
const meta = resolvePageMeta(currentLang, "/");
---

<BaseLayout lang={currentLang} title={meta.title} description={meta.description} path="/">
  <div class="page">
    <AppBar lang={currentLang} client:visible />
    <main class="page-main">
      <Section>
        <Container>
          <div
            style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; padding-block: 32px 48px;"
          >
            <Typography variant="h1" component="h1">Login AI</Typography>
            <Typography variant="h5" color="textSecondary">
              {t("home.heroSubtitle")}
            </Typography>
            <Typography variant="body1" color="textSecondary">
              <span style="display: block; max-width: 720px; margin-inline: auto;">
                {t("home.heroText")}
              </span>
            </Typography>
            <div
              style="display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 16px;"
            >
              <Button href="#solutions" variant="contained" size="large">
                {t("home.heroSolutionsCta")}
              </Button>
              <Button href="#services" variant="outlined" size="large">
                {t("home.heroCta")}
              </Button>
            </div>
          </div>
        </Container>
      </Section>

      <ServiceTabsSection
        services={services}
        lang={currentLang}
        images={serviceCovers}
        alt
        id="services"
        client:visible
      />

      <Section id="solutions">
        <Container>
          <SectionHeader
            eyebrow={t("home.solutionsEyebrow")}
            title={t("home.solutionsTitle")}
            subtitle={t("home.solutionsSubtitle")}
          />
          <HomeSolutions solutions={solutions} lang={currentLang} client:visible />
        </Container>
      </Section>

      <Section alt>
        <Container>
          <SectionHeader
            eyebrow={t("home.newsEyebrow")}
            title={t("home.newsTitle")}
            subtitle={t("home.newsSubtitle")}
            action={{
              label: t("home.newsAll"),
              href: routeUrl("/news", currentLang),
              variant: "soft",
            }}
          />
          <HomeNews items={news} lang={currentLang} client:visible />
        </Container>
      </Section>

      <CtaBlock
        title={t("home.ctaTitle")}
        text={t("home.ctaText")}
        buttonLabel={t("home.ctaButton")}
        to="/contacts"
        lang={currentLang}
      />
    </main>
  </div>
</BaseLayout>