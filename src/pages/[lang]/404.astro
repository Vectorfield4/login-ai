---
import BaseLayout from "../../app/layouts/BaseLayout.astro";
import { routeUrl } from "../../shared/data/routes";
import { formatDocTitle } from "../../shared/data/seo";
import { astroDicts } from "../../shared/i18n/dict";
import { createT } from "../../shared/i18n/t";
import { Button, Container, Section, Typography } from "../../shared/ui/atoms";
import { AppBar } from "../../widgets/app-bar";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const currentLang = lang as "ru" | "en";
const t = createT(currentLang, astroDicts);
const title = formatDocTitle(t("notFoundPage.title"));
const description = t("notFoundPage.description");
---

<BaseLayout lang={currentLang} title={title} description={description}>
  <div class="page">
    <AppBar lang={currentLang} client:visible />
    <main class="page-main">
      <Section>
        <Container>
          <div style="display: flex; flex-direction: column; gap: 8px; max-width: 720px;">
            <Typography variant="h1">{t("notFoundPage.code")}</Typography>
            <Typography variant="h2">{t("notFoundPage.title")}</Typography>
            <Typography variant="body1" color="textSecondary">
              {t("notFoundPage.description")}
            </Typography>
            <div style="margin-block-start: 16px;">
              <Button href={routeUrl("/", currentLang)} variant="outlined" size="large">
                {t("notFoundPage.homeLink")}
              </Button>
            </div>
          </div>
        </Container>
      </Section>
    </main>
  </div>
</BaseLayout>