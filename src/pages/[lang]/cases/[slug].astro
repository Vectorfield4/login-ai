---
import { getNewsReferencing } from "../../../app/data/newsCollection";
import BaseLayout from "../../../app/layouts/BaseLayout.astro";
import {
  CaseHero,
  chasovoyAudiences,
  chasovoyCounters,
  chasovoyDashboard,
  chasovoyDepth,
  chasovoyProblem,
  chasovoySolution,
  getCaseBySlug,
  getCases,
  retailAudiences,
  retailCounters,
  retailDashboard,
  retailProblem,
  retailSolution,
} from "../../../entities/case";
import { resolveBreadcrumbs } from "../../../shared/data/breadcrumbs";
import { SCHEMA_TYPE, schemaIri } from "../../../shared/data/schema";
import { resolvePageMeta } from "../../../shared/data/seo";
import { astroDicts } from "../../../shared/i18n/dict";
import { createT } from "../../../shared/i18n/t";
import { Container, Section } from "../../../shared/ui/atoms";
import { SectionHeader } from "../../../shared/ui/molecules";
import { Breadcrumbs } from "../../../shared/ui/organisms/Breadcrumbs";
import { CountersSection } from "../../../shared/ui/organisms/CountersSection";
import { CtaBlock } from "../../../shared/ui/organisms/CtaBlock";
import { SliderSection } from "../../../shared/ui/organisms/SliderSection";
import { StatGrid } from "../../../shared/ui/organisms/StatGrid";
import { StatsSection } from "../../../shared/ui/organisms/StatsSection";
import { TileSection } from "../../../shared/ui/organisms/TileSection";
import { AppBar } from "../../../widgets/app-bar";
import { CaseEcosystemSection } from "../../../widgets/case-ecosystem";

const CHASOVOY = "cases.reputation-monitoring-platform";
const RETAIL = "cases.retail-support-bot";

export function getStaticPaths() {
  const langs = ["ru", "en"] as const;
  const cases = getCases();
  return langs.flatMap((lang) =>
    cases.map((c) => ({
      params: { lang, slug: c.slug },
    }))
  );
}

const { lang, slug } = Astro.params;
const currentLang = lang as "ru" | "en";
const caseItem = getCaseBySlug(slug);
if (!caseItem) {
  return Astro.redirect(`/${lang}/404`);
}

const meta = resolvePageMeta(currentLang, `/cases/${slug}`);
const t = createT(currentLang, astroDicts);
const breadcrumbs = resolveBreadcrumbs(`/cases/${slug}`, currentLang);
// Обратная связь: статьи, ссылающиеся на этот кейс в frontmatter.
const relatedNews = await getNewsReferencing("case", slug, currentLang);
---

<BaseLayout lang={currentLang} title={meta.title} description={meta.description} path={`/cases/${slug}`}>
  <div class="page">
    <AppBar lang={currentLang} client:visible />
    <main class="page-main" itemScope itemType={schemaIri(SCHEMA_TYPE.webPage)}>
      {breadcrumbs ? (
        <Breadcrumbs items={breadcrumbs.items} lang={currentLang} />
      ) : null}

      <CaseHero lang={currentLang} case={caseItem} />

      <Section alt>
        <Container>
          <SectionHeader
            eyebrow={t("casePage.resultsEyebrow")}
            title={t("casePage.resultsTitle")}
          />
          <StatGrid lang={currentLang} items={caseItem.metrics} />
        </Container>
      </Section>

      {caseItem.slug === "reputation-monitoring-platform" ? (
        <Fragment>
          <CountersSection lang={currentLang} items={chasovoyCounters} />
          <TileSection lang={currentLang} alt eyebrow={t("casePage.problemEyebrow")} title={t(`${CHASOVOY}.problem.title`)} items={chasovoyProblem} />
          <TileSection lang={currentLang} title={t(`${CHASOVOY}.solution.title`)} items={chasovoySolution} />
          <StatsSection lang={currentLang} alt title={t(`${CHASOVOY}.dashboard.title`)} items={chasovoyDashboard} />
          <SliderSection
            title={t(`${CHASOVOY}.depth.title`)}
            min={1}
            max={7}
            defaultValue={4}
            fromLabel={`${CHASOVOY}.depth.fromLabel`}
            toLabel={`${CHASOVOY}.depth.toLabel`}
            levels={chasovoyDepth}
            lang={currentLang}
            client:load
          />
          <TileSection lang={currentLang} alt title={t(`${CHASOVOY}.audiences.title`)} items={chasovoyAudiences} />
        </Fragment>
      ) : null}

      {caseItem.slug === "retail-support-bot" ? (
        <Fragment>
          <CountersSection lang={currentLang} items={retailCounters} />
          <TileSection lang={currentLang} alt eyebrow={t("casePage.problemEyebrow")} title={t(`${RETAIL}.problem.title`)} items={retailProblem} />
          <TileSection lang={currentLang} title={t(`${RETAIL}.solution.title`)} items={retailSolution} />
          <StatsSection lang={currentLang} alt title={t(`${RETAIL}.dashboard.title`)} items={retailDashboard} />
          <TileSection lang={currentLang} alt title={t(`${RETAIL}.audiences.title`)} items={retailAudiences} />
        </Fragment>
      ) : null}

      <CaseEcosystemSection relevants={caseItem.relevants} lang={currentLang} />

      <CtaBlock
        title={t("casePage.ctaTitle")}
        text={t("casePage.ctaText")}
        buttonLabel={t("casePage.ctaButton")}
        to="/contacts"
        lang={currentLang}
      />
    </main>
  </div>
</BaseLayout>