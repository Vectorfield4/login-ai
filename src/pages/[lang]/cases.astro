---
import BaseLayout from "../../app/layouts/BaseLayout.astro";
import { CaseCard } from "../../entities/case/ui/organisms/CaseCard";
import { getCases } from "../../shared/data/entities";
import { resolvePageMeta } from "../../shared/data/seo";
import { astroDicts } from "../../shared/i18n/dict";
import { createT } from "../../shared/i18n/t";
import { Alert, Container, Grid, Section } from "../../shared/ui/atoms";
import { SectionHeader } from "../../shared/ui/molecules";
import { CtaBlock } from "../../shared/ui/organisms/CtaBlock";
import { PageHero } from "../../shared/ui/organisms/PageHero";
import { AppBar } from "../../widgets/app-bar";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const currentLang = lang as "ru" | "en";
const meta = resolvePageMeta(currentLang, "/cases");
const t = createT(currentLang, astroDicts);
const cases = getCases();
---

<BaseLayout lang={currentLang} title={meta.title} description={meta.description}>
  <div class="page">
    <AppBar lang={currentLang} client:visible />
    <main class="page-main">
      <PageHero
        title={t("casesPage.title")}
        subtitle={t("casesPage.subtitle")}
        text={t("casesPage.text")}
      >
        <div
          style="max-width: 720px; margin-inline: auto; margin-block-start: 24px; text-align: left;"
        >
          <Alert severity="info">{t("casesPage.demoNotice")}</Alert>
        </div>
      </PageHero>

      <Section alt>
        <Container>
          <SectionHeader
            eyebrow={t("casesPage.sectionEyebrow")}
            title={t("casesPage.sectionTitle")}
            subtitle={t("casesPage.sectionSubtitle")}
          />
          <Grid container spacing={3}>
            {cases.map((caseItem) => (
              <Grid item key={caseItem.slug} size={12} sm={6} md={4}>
                <CaseCard case={caseItem} t={t} lang={currentLang} />
              </Grid>
            ))}
          </Grid>
        </Container>
      </Section>

      <CtaBlock
        title={t("casesPage.ctaTitle")}
        text={t("casesPage.ctaText")}
        buttonLabel={t("casesPage.ctaButton")}
        to="/contacts"
        lang={currentLang}
      />
    </main>
  </div>
</BaseLayout>